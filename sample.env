# Copy this file to .env in the project root.
# Vite reads these public values at dev-server startup / build time.
# Restart your local development server or rebuild after changing them.
# Do not put secrets in VITE_ variables: they are included in the browser bundle.

# Show the download banner across login, signup, onboarding, and signed-in pages.
# Only "true" enables it. Disabled by default until you have a real download link.
VITE_APP_DOWNLOAD_ENABLED=true

# Absolute HTTPS download or app-store URL. A missing/invalid URL hides the banner.
# Example: https://your-domain.com/download
VITE_APP_DOWNLOAD_URL=

# Dismissing the banner is remembered in this browser's local storage,
# including across logouts and future visits.
# To show it again for testing, remove the local-storage key:
# familybucket:download-app:dismissed
